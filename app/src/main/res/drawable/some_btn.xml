<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#d0d0d0"/>
            <stroke
                android:width="1dp"
                android:color="#e0e0e0"/>
            <corners android:radius="3dp"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#f0f0f0"
                android:endColor="#b0b0b0"
                android:angle="270"
                android:centerColor="#a0a0a0"/>
            <stroke
                android:width="1dp"
                android:color="#c0c0c0"/>
            <corners android:radius="4dp"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
        </shape>
    </item>
</selector>
