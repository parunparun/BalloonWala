<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/AppTheme.AppBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/AppTheme.PopupOverlay"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/puzzleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Stats Bar -->
        <LinearLayout
            android:id="@+id/statsBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="?attr/colorPrimary"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/colorStatBox">
                <TextView android:id="@+id/movesCountTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOVES" android:textColor="@color/colorStatLabel" android:textSize="10sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/colorStatBox" android:layout_marginStart="16dp">
                <Chronometer android:id="@+id/timerChronometer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TIME" android:textColor="@color/colorStatLabel" android:textSize="10sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Puzzle Grid (True Bidirectional packed Chain Mesh) ── -->

        <!-- Row 1 -->
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates1_1" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintHorizontal_chainStyle="packed" app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@+id/statsBar" app:layout_constraintBottom_toTopOf="@+id/buttonCoordinates2_1"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates1_2"
            app:layout_constraintVertical_bias="0.5" android:layout_marginTop="24dp"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates1_2" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates1_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates1_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates1_1" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates1_3"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates1_3" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates1_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates1_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates1_2" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates1_4"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates1_4" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates1_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates1_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates1_3" app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Row 2 -->
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates2_1" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@+id/buttonCoordinates1_1" app:layout_constraintBottom_toTopOf="@+id/buttonCoordinates3_1"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates2_2"
            android:layout_marginTop="8dp"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates2_2" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates2_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates2_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates2_1" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates2_3"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates2_3" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates2_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates2_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates2_2" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates2_4"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates2_4" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates2_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates2_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates2_3" app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Row 3 -->
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates3_1" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@+id/buttonCoordinates2_1" app:layout_constraintBottom_toTopOf="@+id/buttonCoordinates4_1"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates3_2"
            android:layout_marginTop="8dp"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates3_2" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates3_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates3_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates3_1" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates3_3"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates3_3" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates3_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates3_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates3_2" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates3_4"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates3_4" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates3_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates3_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates3_3" app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Row 4 -->
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates4_1" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@+id/buttonCoordinates3_1" app:layout_constraintBottom_toTopOf="@+id/actionButtons"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates4_2"
            android:layout_marginTop="8dp"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates4_2" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates4_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates4_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates4_1" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates4_3"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates4_3" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates4_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates4_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates4_2" app:layout_constraintEnd_toStartOf="@+id/buttonCoordinates4_4"/>
        <Button style="@style/TileButton" android:id="@+id/buttonCoordinates4_4" android:layout_width="75dp" android:layout_height="75dp"
            app:layout_constraintTop_toTopOf="@+id/buttonCoordinates4_1" app:layout_constraintBottom_toBottomOf="@+id/buttonCoordinates4_1"
            app:layout_constraintStart_toEndOf="@+id/buttonCoordinates4_3" app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Action Row 1 -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/buttonCoordinates4_1"
            app:layout_constraintBottom_toTopOf="@+id/hintSolutionButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <Button android:id="@+id/btnPlayAgain"
                android:layout_width="0dp" android:layout_height="54dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="@string/play_again" android:textSize="12sp"
                android:textStyle="bold" android:textAllCaps="false" android:onClick="playAgain"/>
            <Button android:id="@+id/btnUndo" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/undo" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:onClick="undo"/>
            <Button android:id="@+id/btnMenu" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="@string/menu" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:onClick="backToMainActivity"/>
        </LinearLayout>

        <!-- Action Row 2 -->
        <LinearLayout
            android:id="@+id/hintSolutionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/actionButtons"
            app:layout_constraintBottom_toBottomOf="parent">
            <Button android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="54dp" android:layout_weight="1.2"
                android:layout_marginEnd="6dp" android:text="@string/how_to_play"
                android:textSize="10sp" android:textStyle="bold" android:textAllCaps="false"
                android:padding="0dp" android:onClick="showHowToPlay"/>
            <Button android:id="@+id/btnHint" android:layout_width="0dp"
                android:layout_height="54dp" android:layout_weight="0.8"
                android:layout_marginEnd="6dp" android:text="@string/hint"
                android:textSize="11sp" android:textStyle="bold" android:textAllCaps="false"
                android:onClick="showHint"/>
            <Button android:id="@+id/btnSolution" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/solution" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="false" android:onClick="showSolution"/>
            <Button android:id="@+id/btnStickers" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="@string/sticker_book" android:textSize="10sp" android:textStyle="bold" android:textAllCaps="false" android:padding="0dp" android:onClick="showStickerBook"/>
        </LinearLayout>

        <!-- Hint Overlay -->
        <com.example.balloonwala.views.HintArrowView
            android:id="@+id/hintArrowView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Celebration Layer -->
    <FrameLayout
        android:id="@+id/celebrationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/colorOverlay"
        android:clickable="true"
        android:focusable="true">
        <FrameLayout android:id="@+id/balloonContainer" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="32dp">
            <TextView android:id="@+id/celebrationEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎈" android:textSize="72sp"/>
            <TextView android:id="@+id/celebrationTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/puzzle_solved" android:textSize="40sp" android:textStyle="bold" android:textColor="?attr/colorPrimary"/>
            <TextView android:id="@+id/celebrationStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/colorTextSecondary" android:gravity="center"/>
            <TextView android:id="@+id/celebrationBest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/colorBestScore" android:visibility="gone"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp">
                <Button android:id="@+id/celebrationPlayAgain" android:layout_width="160dp" android:layout_height="56dp" android:layout_marginEnd="8dp" android:text="@string/play_again_awesome" android:textStyle="bold" android:textAllCaps="false"/>
                <Button android:id="@+id/celebrationDismiss" android:layout_width="160dp" android:layout_height="56dp" android:text="@string/view_board" android:textStyle="bold" android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
