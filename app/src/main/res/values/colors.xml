<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── App Theme Colors ───────────────────────────────
         colorPrimary drives toolbar, stats bar, celebration
         button and title — change once to retheme the app  -->
    <color name="colorPrimary">#FF6B6B</color>
    <color name="colorPrimaryDark">#E05555</color>
    <color name="colorAccent">#1DD1A1</color>

    <!-- ── App Background ────────────────────────────────
         Warm cream — used on puzzle and main backgrounds   -->
    <color name="colorBackground">#FFF9F0</color>

    <!-- ── Stats Bar ─────────────────────────────────────
         Semi-transparent white boxes inside the red bar   -->
    <color name="colorStatBox">#33FFFFFF</color>
    <color name="colorStatLabel">#CCFFFFFF</color>

    <!-- ── Action Buttons ────────────────────────────────
         Play Again (green), Undo (grey), Menu (blue)      -->
    <color name="colorBtnPlayAgain">#1DD1A1</color>
    <color name="colorBtnUndo">#DFE6E9</color>
    <color name="colorBtnUndoText">#636E72</color>
    <color name="colorBtnMenu">#54A0FF</color>

    <!-- ── Hint + Solution + Sticker Buttons ────────────────
         Hint — warm amber; Solution — indigo; Sticker - purple -->
    <color name="colorBtnHint">#FDCB6E</color>
    <color name="colorBtnSolution">#6C5CE7</color>
    <color name="colorBtnSticker">#A29BFE</color>

    <!-- ── Celebration Overlay ───────────────────────────
         Semi-transparent white overlay background         -->
    <color name="colorOverlay">#EDFFFFFF</color>

    <!-- ── Text Colors ───────────────────────────────────
         Secondary grey text (stats in celebration screen) -->
    <color name="colorTextSecondary">#666666</color>

    <!-- ── Best Score ────────────────────────────────────
         Orange highlight for new best indicator           -->
    <color name="colorBestScore">#FF9F43</color>

</resources>