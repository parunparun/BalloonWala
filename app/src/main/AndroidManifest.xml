<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:compileSdkVersion="29"
    android:compileSdkVersionCodename="10"
    package="com.example.balloonwala"
    platformBuildVersionCode="29"
    platformBuildVersionName="10">
    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="29"/>
    <application
        android:name=".BalloonWalaApp"
        android:theme="@style/AppTheme.AppBarOverlay"
        android:label="@string/app_name"
        android:icon="@mipmap/balloon_wala"
        android:debuggable="true"
        android:foreground="@mipmap/balloon_wala_foreground"
        android:testOnly="true"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/balloon_wala_round"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory">
        <activity
            android:theme="@style/AppTheme.NoActionBar"
            android:name="com.example.balloonwala.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/AppTheme.NoActionBar"
            android:label="@string/app_name"
            android:name="com.example.balloonwala.MainActivity"
            android:screenOrientation="portrait"
            android:parentActivityName="com.example.balloonwala.SplashActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SplashActivity"/>
        </activity>
        <activity
            android:theme="@style/AppTheme.NoActionBar"
            android:name="com.example.balloonwala.PuzzleActivity"
            android:screenOrientation="portrait"
            android:parentActivityName="com.example.balloonwala.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity"/>
        </activity>
    </application>
</manifest>
